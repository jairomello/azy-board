{
  "name": "azy-board",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "predev:api": "bun run db:migrate",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:mcp": "bun run --cwd apps/mcp dev",
    "dev": "bun run dev:api & bun run dev:web",
    "build:web": "bun run --cwd apps/web build",
    "build:analyze": "bun run --cwd apps/web build:analyze",
    "build:api": "bun run --cwd apps/api build",
    "build:mcp": "bun run --cwd apps/mcp build",
    "build": "bun run build:api && bun run build:web && bun run build:mcp",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:seed": "bun run --cwd apps/api db:seed",
    "setup": "bun run --cwd apps/api setup",
    "test": "bun test --isolate",
    "test:web": "bun test --isolate apps/web/src",
    "test:integration": "bun run --cwd apps/api test:integration",
    "test:smoke": "bun run scripts/smoke.ts",
    "test:e2e": "bun run e2e/regression.ts",
    "test:visual": "bun run e2e/visual.ts",
    "test:regression": "bun run scripts/regression.ts",
    "test:mcp-catalog": "bun run scripts/check-mcp-catalog.ts",
    "test:error-contract": "bun test apps/api/src/middleware/errorResponse.test.ts apps/mcp/src/handlers.test.ts",
    "test:agent-skill": "bun run scripts/check-agent-skill.ts",
    "generate:docs": "bun run scripts/generate-docs.ts",
    "check:docs": "bun run scripts/check-docs.ts",
    "check:i18n": "bun run scripts/check-i18n.ts",
    "check:frontend-tests": "bun run scripts/check-frontend-tests.ts",
    "check:bundle": "bun run scripts/check-bundle.ts",
    "check:persistence": "bun run scripts/check-persistence-boundaries.ts",
    "test:migrations": "bun test apps/api/src/db/migration.test.ts apps/api/src/db/integrity.test.ts apps/api/src/db/timestamp.test.ts",
    "test:mcp": "bun run --cwd apps/mcp test",
    "evals": "bun run scripts/evals.ts",
    "evals:gate": "bun run scripts/evalGate.ts",
    "evals:env": "bun run scripts/buildEvalEnv.ts",
    "lint": "bun run scripts/lint.ts",
    "typecheck": "bun run --cwd packages/types typecheck && bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck && bun run --cwd apps/mcp typecheck",
    "check": "bun run typecheck && bun run lint && bun run check:persistence && bun test --isolate && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  }
}
