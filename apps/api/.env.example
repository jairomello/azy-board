DATABASE_URL=./dev.db
JWT_SECRET=change-me-use-a-long-random-secret
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
UPLOADS_DIR=./uploads
STORAGE_ADAPTER=local
MAX_FILE_SIZE=10485760
# Foto de perfil: limite do upload original (padrão 800 KB) e lado fixo do avatar normalizado
MAX_AVATAR_SIZE=819200
AVATAR_SIZE=256
# 32 bytes em hexadecimal; gere com: openssl rand -hex 32
ASSISTANT_ENCRYPTION_KEY=
ASSISTANT_EXPOSE_ERRORS=false
# [SECURITY] Confie em X-Forwarded-For apenas atrás de um proxy confiável (ex.: Nginx Proxy Manager)
TRUST_PROXY=false
# Rate limiting de login (padrões mostrados; ajustáveis por ambiente)
# LOGIN_WINDOW_MS=900000
# LOGIN_MAX_ATTEMPTS_PER_IP=30
# LOGIN_MAX_FAILURES_PER_IDENTITY=5
# LOGIN_PROGRESSIVE_DELAY_MS=250
# LOGIN_MAX_DELAY_MS=2000
