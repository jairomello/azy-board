{
  "name": "@azy-board/api",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external sharp",
    "start": "bun run dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:migrate:pg": "bun run src/db/postgres/migrate.ts",
    "db:seed": "bun run src/scripts/seed.ts",
    "setup": "bun run db:migrate && bun run src/scripts/setup.ts",
    "test:integration": "bun test src/integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.57.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@sentry/node": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "ioredis": "^6.0.0",
    "jose": "^5.9.0",
    "openai": "^7.9.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.4",
    "@azy-board/tool-registry": "workspace:*",
    "@azy-board/domain": "workspace:*",
    "@azy-board/api-contracts": "workspace:*",
    "@azy-board/realtime-contracts": "workspace:*",
    "@azy-board/assistant-contracts": "workspace:*",
    "@azy-board/ui-contracts": "workspace:*",
    "@azy-board/types": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0"
  }
}