{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "azyboard": "allow"
    }
  },
  "mcp": {
    "azy-board": {
      "type": "local",
      "command": ["bun", "run", "apps/mcp/src/index.ts"],
      "enabled": true,
      "environment": {
        "EASYBOARD_API_KEY": "{env:EASYBOARD_API_KEY}",
        "EASYBOARD_URL": "http://localhost:3000",
        "AZYBOARD_PROJECT_ID": ""
      }
    },
    "azy-board-remoto": {
      "type": "remote",
      "url": "https://azyboard.exemplo.com/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:EASYBOARD_API_KEY}"
      }
    }
  }
}
