# Modelo para /opt/azyboard/.env.production no servidor.
# Substitua todos os valores CHANGE_ME usando um gerador local no servidor.
# Não versionar o arquivo real nem enviar estes segredos por chat.

AZYBOARD_IMAGE_TAG=latest
POSTGRES_USER=azyboard
POSTGRES_DB=azyboard
POSTGRES_PASSWORD=CHANGE_ME_HEX_64
VALKEY_PASSWORD=CHANGE_ME_HEX_64
JWT_SECRET=CHANGE_ME_HEX_64
ASSISTANT_ENCRYPTION_KEY=CHANGE_ME_HEX_64

# Token Cloudflare com Zone:DNS:Edit restrito a jairo.tools; usado pelo ACME DNS-01.
CLOUDFLARE_API_TOKEN=CHANGE_ME
# Token do Tunnel azyboard-prod; não é o token da API geral da conta.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME
ACME_EMAIL=CHANGE_ME

AZYBOARD_AUTH_PROVIDER=LOCAL

# Login integrado com Microsoft Entra ID (tenant NTCONSULT). Obrigatório quando
# AZYBOARD_AUTH_PROVIDER=MICROSOFT; com MICROSOFT o login por senha é desativado.
# O redirect precisa estar cadastrado no app registration "Azy Board".
AZYBOARD_AUTH_REDIRECT_URL=https://azyboard.jairo.tools/api/auth/oauth/microsoft/callback
AZYBOARD_MICROSOFT_CLIENT_ID=a6234275-febb-4928-aaea-6971f9ba573e
AZYBOARD_MICROSOFT_CLIENT_SECRET=CHANGE_ME
AZYBOARD_MICROSOFT_TENANT_ID=85b445ed-5835-4425-b84d-d0c4fa2c767d
